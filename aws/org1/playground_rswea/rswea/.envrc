#!/usr/bin/env bash
set +x # hide secret env values from output

TF_VAR_workspace=rswea
export TF_VAR_workspace

# region that supports AWS::Lambda::MicrovmImage
AWS_REGION=us-east-2
export AWS_REGION

WORKSPACE_PATH="${CODEBUILD_SRC_DIR_SecondSourceOutput}/cdk"
export WORKSPACE_PATH
WORKSPACE="$WORKSPACE_PATH"
export WORKSPACE
